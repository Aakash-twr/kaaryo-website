# ---------------------------------------------------------------------------
# EmailJS — booking confirmation emails
#
# Copy this file to `.env.local` and fill in the three values from your
# EmailJS dashboard (https://dashboard.emailjs.com). Restart `npm run dev`
# afterwards: Vite only reads env files at startup.
#
# All three are PUBLIC — they ship in the JavaScript bundle, which is how
# EmailJS is designed to work. Do not put an EmailJS *private* key here.
# Protect the service instead by:
#   1. Account → Security → turn OFF "Allow EmailJS API for non-browser apps"
#   2. Account → Security → add your domains to the allowlist
#   3. Email Services → set a sensible monthly/hourly rate limit
# Without those, anyone can read these ids and send mail through your quota.
#
# The booking form fails loudly and tells the customer to phone instead when
# these are missing, so the site is safe to deploy before they are set.
# ---------------------------------------------------------------------------

VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
# Separate template used for the contact-form acknowledgement email.
# Create a second template in the EmailJS dashboard and paste its ID here.
VITE_EMAILJS_CONTACT_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
